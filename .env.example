# ---------------------------------------------------------------------------
# Reviewer2 — environment variables (copy to .env)
#
# Everything here is optional: config.yaml already carries sane defaults.
# Nesting uses "__", e.g. REVIEWER2_LLM__MODEL maps to llm.model.
# ---------------------------------------------------------------------------

# --- Language model (local, free) ---
REVIEWER2_LLM__PROVIDER=ollama
REVIEWER2_LLM__MODEL=qwen2.5:7b-instruct
REVIEWER2_LLM__BASE_URL=http://localhost:11434
REVIEWER2_LLM__TEMPERATURE=0.1

# --- Transcription ---
REVIEWER2_TRANSCRIPTION__MODEL=small
# REVIEWER2_TRANSCRIPTION__LANGUAGE=pt
REVIEWER2_TRANSCRIPTION__DEVICE=auto

# --- Embeddings ---
REVIEWER2_EMBEDDINGS__MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
REVIEWER2_EMBEDDINGS__DEVICE=cpu

# --- Retrieval ---
REVIEWER2_RETRIEVAL__TOP_K=6
REVIEWER2_RETRIEVAL__MIN_SCORE=0.25

# --- Report ---
REVIEWER2_REPORT__LANGUAGE=pt

# --- Alternative: any OpenAI-compatible local server (llama.cpp, LM Studio) ---
# REVIEWER2_LLM__PROVIDER=llamacpp
# REVIEWER2_LLM__BASE_URL=http://localhost:8080
# REVIEWER2_LLM__MODEL=local-model
# REVIEWER2_LLM__API_KEY=

# --- Alternative: a cloud endpoint (no RAM used on this machine) ---
# Note: with a remote provider, transcripts and reference documents leave
# this computer. Do not use it for confidential material.
#
# Groq (free tier, OpenAI-compatible) — key at https://console.groq.com/keys
# REVIEWER2_LLM__PROVIDER=openai-compatible
# REVIEWER2_LLM__BASE_URL=https://api.groq.com/openai
# REVIEWER2_LLM__MODEL=llama-3.1-8b-instant
# REVIEWER2_LLM__API_KEY=gsk_...
#
# OpenRouter — key at https://openrouter.ai/keys
# REVIEWER2_LLM__BASE_URL=https://openrouter.ai/api
# REVIEWER2_LLM__MODEL=qwen/qwen-2.5-14b-instruct

# Point to a different config file
# REVIEWER2_CONFIG=config.yaml
